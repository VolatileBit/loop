{
  "name": "@polyweave/loop",
  "version": "0.1.0",
  "private": false,
  "description": "Autonomous issue-runner: drives a coding agent through implement → verify → review cycles against a repo's markdown issue tracker, in an isolated git worktree.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolatileBit/loop.git"
  },
  "homepage": "https://github.com/VolatileBit/loop#readme",
  "bugs": "https://github.com/VolatileBit/loop/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "loop": "./bin/loop.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "loop.config.example.json"
  ],
  "scripts": {
    "loop": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke:gap": "node scripts/gap-live-smoke.mjs"
  },
  "dependencies": {
    "rulesync": "16.29.0",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
